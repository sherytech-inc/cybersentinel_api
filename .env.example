# ── Core Application Settings ────────────────────────────────────────────────
APP_NAME="CyberSentinel API"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO
# Note: For production, specify origins like https://your-domain.example
CORS_ORIGINS=http://localhost:64756,http://localhost:3000,http://127.0.0.1:64756,http://127.0.0.1:3000
REQUIRE_DATABASE=true

# ── Model 3 External Threat Intelligence Keys (Moved to Edge Functions) ────────
# GeoIP uses ip-api.com — no key required

# ── Core Threat Intelligence Cache ──────────────────────────────────────────
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000

# ── Supabase Database Connectivity ──────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-local-validation-secret
# SUPABASE_SERVICE_ROLE_KEY is removed. Local client only uses user JWTs.

# ── Model 4 Decision Engine Core Configurations ────────────────────────────
M4_WEIGHT_MODEL1=0.60
M4_WEIGHT_MODEL2=0.10
M4_WEIGHT_MODEL3=0.30
M4_MAX_IF_CONTRIBUTION=15.0
INTEL_BLACKLIST_ABUSE_THRESHOLD=80
INTEL_BLACKLIST_VT_THRESHOLD=5

M4_SAFE_MAX=25.0
M4_LOW_MAX=50.0
M4_MEDIUM_MAX=75.0
M4_HIGH_MAX=90.0

M4_ACTION_ALLOW_MAX=25.0
M4_ACTION_MONITOR_MAX=50.0
M4_ACTION_INVESTIGATE_MAX=75.0
M4_ACTION_ALERT_MAX=90.0

# ── AI Copilot ────────────────────────────────────────────────────────────
ENABLE_DEMO_MODE=true
GROQ_API_KEY=your-groq-api-key

# ── Scanner and Threat Intelligence ──────────────────────────────────────
VIRUSTOTAL_API_KEY=your-virustotal-api-key
ABUSEIPDB_API_KEY=your-abuseipdb-api-key
