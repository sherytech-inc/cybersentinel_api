# CyberSentinel API — Environment Variables
# cp .env.example .env  then fill in real values

APP_NAME="CyberSentinel API"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Model 3 API keys
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here
# GeoIP uses ip-api.com — no key required

# Cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000

# Scoring weights (must sum to 1.0)
SCORE_WEIGHT_ABUSEIPDB=0.40
SCORE_WEIGHT_VIRUSTOTAL=0.40
SCORE_WEIGHT_GEO=0.20

CORS_ORIGINS=["*"]
